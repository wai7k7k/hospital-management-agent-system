<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="xian.woniuxy.reghos.mapper.MedicineMapper">

    <resultMap type="xian.woniuxy.domain.Medicine" id="MedicineResult">
        <result property="medicineId" column="medicine_id"/>
        <result property="medicineName" column="medicine_name"/>
        <result property="medicinePrice" column="medicine_price"/>
        <result property="medicineStock" column="medicine_stock"/>
        <result property="medicineDetails" column="medicine_details"/>
        <result property="softDel" column="soft_del"/>
        <result property="recipel" column="recipel"/>
    </resultMap>
    <insert id="insertExample" keyColumn="medicineId" keyProperty="medicineId" parameterType="xian.woniuxy.domain.Medicine" useGeneratedKeys="true">
        insert into medicine
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="medicineId != null">medicine_id,</if>
            <if test="medicineName != null">medicine_name,</if>
            <if test="medicinePrice != null">medicine_price,</if>
            <if test="medicineStock != null">medicine_stock,</if>
            <if test="medicineDetails != null">medicine_details,</if>
            <if test="recipel != null">recipel,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="medicineId  != null">#{medicineId},</if>
            <if test="medicineName  != null">#{medicineName},</if>
            <if test="medicinePrice != null">#{medicinePrice},</if>
            <if test="medicineStock   != null">#{medicineStock },</if>
            <if test="medicineDetails  != null">#{medicineDetails},</if>
            <if test="recipel != null">#{recipel},</if>
        </trim>
    </insert>
    <update id="updateByIdsoftDel" parameterType="java.util.List">
        <foreach collection="ids" item="item" index="index" open="" close="" separator=";">
            update medicine
            <set>
                soft_del=0
            </set>
            where medicine_id = ${item}
        </foreach>
    </update>


</mapper>
