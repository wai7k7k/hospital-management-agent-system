# 应用配置
APP_NAME=hospital-ai-service
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=True
LOG_LEVEL=INFO

# 服务器配置
HOST=0.0.0.0
PORT=8000
WORKERS=4

# 通义千问配置
# 请复制此文件为 .env 并填入真实的API key
DASH_SCOPE_API_KEY=your-qwen-api-key-here
QWEN_MODEL=qwen-plus
QWEN_TEMPERATURE=0.7
QWEN_MAX_TOKENS=2000

# Pinecone 配置
# 请复制此文件为 .env 并填入真实的API key
PINECONE_API_KEY=your-pinecone-api-key-here
PINECONE_ENVIRONMENT=us-east-1
PINECONE_INDEX=hospital-ai-index
PINECONE_DIMENSION=1536

# MongoDB 配置
MONGODB_URI=mongodb://root:123456@127.0.0.1:27017/?authSource=admin
MONGODB_DATABASE=hospital_ai

# Redis 配置
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=123456

# RabbitMQ 配置
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USER=root
RABBITMQ_PASSWORD=123456
RABBITMQ_VHOST=/

# 医院系统配置
HOSPITAL_API_BASE_URL=http://localhost:8080
HOSPITAL_API_TIMEOUT=30
HOSPITAL_API_TOKEN=

# 事件驱动配置
EVENT_RETENTION_DAYS=90
REMINDER_DEFAULT_DELAY_SECONDS=7200
FOLLOW_UP_REMINDER_DELAY_SECONDS=86400
MEDICATION_REMINDER_INTERVAL_HOURS=8
MEDICATION_REMINDER_INTERVAL_SECONDS=28800
MEDICATION_REMINDER_TIMES=21
PHARMACY_PICKUP_LOCATION=门诊一楼药房

# WebSocket 配置
WS_HEARTBEAT_INTERVAL=30
WS_MAX_CONNECTIONS=1000

# SSE 配置
SSE_HEARTBEAT_INTERVAL=15
SSE_TIMEOUT=300

# 监控配置
PROMETHEUS_PORT=9090
ENABLE_METRICS=True

# 安全配置
SECRET_KEY=your-secret-key-change-in-production
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
